# Copy this file to .env and fill in the values. Never commit .env.

# API tests
RHOMBUS_API_BASE_URL=https://api.rhombusai.com/api/
# Value of the Authorization header from any api.rhombusai.com request in DevTools, without "Bearer "
RHOMBUS_API_TOKEN=
# Value of the x-org-id header from the same request
RHOMBUS_ORG_ID=
RHOMBUS_PROJECT_ID=5282
RHOMBUS_PROJECT_NAME=Take-Home Exercise

# UI tests
RHOMBUS_APP_URL=https://rhombusai.com
